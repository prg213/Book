{
  "expo": {
    "name": "MyStoryBook",
    "slug": "mystorybook-native",
    "owner": "prg123s-team",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mystorybook",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F5F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mystorybook.app"
    },
    "android": {
      "package": "com.mystorybook.app",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5cb884a7-b64c-45e2-b468-42da6d6ae6b9"
      }
    }
  }
}
