{
  "expo": {
    "name": "MyStoryBook",
    "slug": "mystorybook-native",
    "owner": "prg123s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mystorybook-native",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F5F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mystorybook.app"
    },
    "android": {
      "package": "com.mystorybook.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "extraMavenRepos": [],
            "kotlinVersion": "2.0.21"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5cb884a7-b64c-45e2-b468-42da6d6ae6b9"
      }
    }
  }
}
